# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file — it is in .gitignore.

# ── PostgreSQL ────────────────────────────────────────────────────────────
# Local development:
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/recruitment_db
# Railway / Neon / Supabase (replace with your connection string):
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# ── Qdrant ────────────────────────────────────────────────────────────────
# Local (running qdrant.exe):
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=candidates
# Qdrant Cloud (replace with your cluster URL and API key):
# QDRANT_URL=https://YOUR-CLUSTER.qdrant.io
# QDRANT_API_KEY=your_api_key

# ── Session ───────────────────────────────────────────────────────────────
# Generate a strong random secret: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change_me_to_a_random_64_char_hex_string
SESSION_EXPIRE_DAYS=30

# ── Server ────────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
RELOAD=false
